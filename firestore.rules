rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────────────
    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }
    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }
    function isAdmin(uid) {
      return userExists(uid) && userDoc(uid).data.role == 'admin';
    }
    function isTeacher(uid) {
      return userExists(uid) && userDoc(uid).data.role in ['teacher', 'admin'];
    }
    function isApprovedTeacher(uid) {
      return userExists(uid) && (
        userDoc(uid).data.role == 'admin' ||
        (userDoc(uid).data.role == 'teacher' && userDoc(uid).data.status == 'approved')
      );
    }

    // ─── Users collection ───────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      // Users can update their own doc; admins can update any user
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin(request.auth.uid)
      );
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        isApprovedTeacher(request.auth.uid) ||
        isAdmin(request.auth.uid)
      );
    }

    // ─── Audit log — admin read/write only ──────────────────────────────
    match /auditLog/{logId} {
      allow read: if request.auth != null && isAdmin(request.auth.uid);
      allow create: if request.auth != null && isAdmin(request.auth.uid);
      allow update, delete: if false;
    }

    // ─── Essays collection ──────────────────────────────────────────────
    match /essays/{essayId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;

      // Discussion subcollection (real-time essay forum)
      match /discussion/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ─── Reviews collection ─────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        (request.resource.data.reviewerRole == 'ai' ||
         request.resource.data.reviewerId == request.auth.uid ||
         request.resource.data.reviewerRole == 'teacher');
      allow update: if request.auth != null && (
        resource.data.reviewerId == request.auth.uid ||
        get(/databases/$(database)/documents/essays/$(resource.data.essayId)).data.studentId == request.auth.uid
      );
      allow delete: if request.auth != null;
    }

    // ─── Speaking assignments ────────────────────────────────────────────
    match /speakingAssignments/{assignmentId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && isApprovedTeacher(request.auth.uid);
    }

    // ─── Speaking responses ──────────────────────────────────────────────
    match /speakingResponses/{responseId} {
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        isTeacher(request.auth.uid)
      );
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── Assistant chats ─────────────────────────────────────────────────
    match /assistantChats/{chatId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // ─── Topics ──────────────────────────────────────────────────────────
    match /topics/{topicId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // ─── Messages ────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;

      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && resource.data.studentId == request.auth.uid;
      }
    }

    // ─── Telegram ────────────────────────────────────────────────────────
    match /telegram_links/{linkId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read: if true;
    }

    match /telegram_verified/{docId} {
      allow create: if true;
      allow read, delete: if true;
    }

    // ─── Scheduled tasks ─────────────────────────────────────────────────
    match /scheduledTasks/{taskId} {
      allow read, create, update, delete: if request.auth != null && isApprovedTeacher(request.auth.uid);
    }

    match /schedulerExports/{exportId} {
      allow read, create, delete: if request.auth != null && isApprovedTeacher(request.auth.uid);
      allow update: if false;
    }

    // ─── Progress reports ────────────────────────────────────────────────
    match /progressReports/{reportId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isApprovedTeacher(request.auth.uid);
    }

    // ─── Settings ────────────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if request.auth != null;
      // Platform settings: admin only; everything else: approved teachers
      allow write: if request.auth != null && (
        (settingId == 'platform' && isAdmin(request.auth.uid)) ||
        (settingId != 'platform' && isApprovedTeacher(request.auth.uid))
      );
    }

    // ─── AI detection logs ───────────────────────────────────────────────
    match /ai_detection_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && isTeacher(request.auth.uid);
      allow update, delete: if false;
    }

    // ─── Classes ─────────────────────────────────────────────────────────
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && isApprovedTeacher(request.auth.uid);
    }

    // ─── Groups ──────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && isApprovedTeacher(request.auth.uid);
    }

    // ─── Quizzes ─────────────────────────────────────────────────────────
    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        isApprovedTeacher(request.auth.uid)
      );
    }

    // ─── Game reports ─────────────────────────────────────────────────────
    match /gameReports/{reportId} {
      // Host teacher can read their own reports; admins can read all
      allow read: if request.auth != null && (
        resource.data.hostId == request.auth.uid ||
        isAdmin(request.auth.uid)
      );
      // Only the game system (approved teachers) can write reports
      allow create: if request.auth != null && isApprovedTeacher(request.auth.uid);
      allow update, delete: if false;
    }
  }
}
